# Copy to apps/api/.env. Use a dedicated development PostgreSQL database.
DATABASE_URL=postgresql://erp:CHANGE_ME@127.0.0.1:5432/enterprise_erp?schema=public
JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:3000
# Root-route session cookie; the API keeps its /api prefix.
SESSION_COOKIE_PATH=/
API_BASE_PATH=
API_HOST=127.0.0.1
PORT=4010
NODE_ENV=development
# Used only by the demo seed. Never use demo accounts in production.
DEMO_PASSWORD=DevOnly!ERP2026
