{
  "name": "@erp/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run build -w @erp/shared",
    "dev": "tsc -p tsconfig.json && node --watch dist/main.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:passenger": "node server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsc -p tsconfig.seed.json && node ../../.local/seed/prisma/seed.js"
  },
  "dependencies": {
    "@erp/shared": "*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "prisma": "6.19.0",
    "typescript": "^5.9.0"
  }
}
