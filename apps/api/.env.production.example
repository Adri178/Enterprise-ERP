NODE_ENV=production
DATABASE_URL=postgresql://ERP_USER:CHANGE_ME@DATABASE_HOST:5432/enterprise_erp?schema=public
JWT_SECRET=replace-with-a-new-random-secret-of-at-least-32-characters
FRONTEND_ORIGIN=https://erp.example.com
SESSION_COOKIE_PATH=/
# Root-route API: /api, without a hosting mount prefix.
API_BASE_PATH=
API_HOST=127.0.0.1
PORT=4010
